# Receipts voice settings, sourced by render-day.sh -> pipeline/voice-cast.js (two separate Gemini TTS voices + QA gate).
# Chosen by measurement (pipeline/audio-features.js): Puck (hyped) sits ~9 semitones above Algenib (gravelly, deadpan)
# and is ~35% brighter; Fenrir + Kore were < 1 semitone apart, which is why the first sample sounded like one voice.
VOICE_SKEPTIC=Algenib
VOICE_CLAIM=Puck
STYLE_SKEPTIC="Say in a dry, deadpan, sarcastic, unimpressed voice, crisp and clipped, with a smirk, letting each punchline land flat"
STYLE_CLAIM="Say like an overconfident, loud, hyped-up influencer selling a miracle, fast and theatrical, totally sure of himself"
CLAIM_TEMPO=1.08
# Allowed TTS models, in order. Free tier = 10 requests/day per model (resets 05:30 IST).
TTS_MODELS=gemini-3.8-flash-tts,gemini-2.5-flash-preview-tts
# Never used unless ALLOW_FLAGGED_MODEL=1 (lite: slower/flatter read; 3.1-preview: did not hold the requested voice in tests).
TTS_FLAGGED_MODELS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview
# Wait up to this many seconds for a 429 window before moving to the next allowed model.
TTS_MAX_WAIT=900
